<?xml version="1.0" encoding="utf-8"?>
<!--
  状态栏通知小图标。

  🔴 两条硬规则（改这个文件前先看）：
    1. Android 只取这个图的 **alpha 通道**，颜色一律由系统重染成白色/单色。
       所以里面所有 fillColor / strokeColor 都写 #FFFFFFFF，
       写别的颜色不会报错，但也不会有任何效果。
    2. 必须是**透明背景的剪影**。任何不透明底板都会让图标变成一个白方块。
       这也是为什么不能直接复用启动图标（那是有底的）。

  造型：描边日历 + 实心表头 + 两个挂环 + 两个日期点。
  外框中心线在 3..21，描边宽 2 —— 实际覆盖 2..22，正好留出 1dp 安全边距。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 表头实心条：24dp 下靠大块形状辨认，比纯描边更稳 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M5.5,5h13a2.5,2.5 0 0 1 2.5,2.5V9H3V7.5A2.5,2.5 0 0 1 5.5,5z" />

    <!-- 外框描边 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:pathData="M5.5,5h13a2.5,2.5 0 0 1 2.5,2.5v11a2.5,2.5 0 0 1 -2.5,2.5h-13A2.5,2.5 0 0 1 3,18.5v-11A2.5,2.5 0 0 1 5.5,5z" />

    <!-- 两个挂环 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M7.6,1.5a1.2,1.2 0 0 1 1.2,1.2V7H6.4V2.7a1.2,1.2 0 0 1 1.2,-1.2zM15.2,1.5a1.2,1.2 0 0 1 1.2,1.2V7h-2.4V2.7a1.2,1.2 0 0 1 1.2,-1.2z" />

    <!-- 两个日期点 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M8.1,14.2h1.4a0.9,0.9 0 0 1 0.9,0.9v1.4a0.9,0.9 0 0 1 -0.9,0.9H8.1a0.9,0.9 0 0 1 -0.9,-0.9v-1.4a0.9,0.9 0 0 1 0.9,-0.9zM14.7,14.2h1.4a0.9,0.9 0 0 1 0.9,0.9v1.4a0.9,0.9 0 0 1 -0.9,0.9h-1.4a0.9,0.9 0 0 1 -0.9,-0.9v-1.4a0.9,0.9 0 0 1 0.9,-0.9z" />
</vector>
